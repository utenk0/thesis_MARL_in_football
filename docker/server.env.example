# Copy this file to docker/server.env on PC12041 and replace the paths.
# Both directories must already exist. THESIS_DATA_ROOT is mounted read-only.
THESIS_DATA_ROOT=/absolute/path/to/data/processed
THESIS_OUTPUT_ROOT=/absolute/path/to/artifacts/container_runs
THESIS_FROZEN_ARTIFACT_ROOT=/absolute/path/to/artifacts

# Obtain these values on the server with: id -u; id -g
THESIS_UID=1003
THESIS_GID=1007

# These settings select data for the legacy seven-method GRF services
# (smoke/trial/full). The trajectory services use team_00000P_manifest.json.
TRAINING_DATASET=final_stage_v1
TRAINING_MANIFEST=pilot_split_manifest.json

# Begin with CPU. Adding docker/compose.gpu.yaml selects CUDA and exposes all
# NVIDIA GPUs to both trajectory training and legacy trial/full services.
TRAINING_DEVICE=cpu
MIN_OUTPUT_FREE_GB=20

# Optional: set this to a registry reference when an image is published.
# THESIS_IMAGE=registry.example.edu/utenko/thesis-marl-football:latest
